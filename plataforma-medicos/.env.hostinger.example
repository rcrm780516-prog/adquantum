# ── Copia este archivo como .env en el servidor y llena los valores ──
APP_NAME="Med's Anatomy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-DOMINIO.com
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL de Hostinger (hPanel → Bases de datos)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_medicos
DB_USERNAME=u000000000_medicos
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Correo de Hostinger (hPanel → Correos)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=citas@TU-DOMINIO.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=citas@TU-DOMINIO.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Plataforma ──
PLATAFORMA_NOMBRE="Med's Anatomy"
PLATAFORMA_ESLOGAN="Encuentra a tu médico y agenda en minutos"
VIRTUOSO_LEADS_EMAIL=hola@virtuoso.mx
VIRTUOSO_WHATSAPP=
ADQUANTUM_API_URL=

# ── IA (Claude) ── https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# ── WhatsApp Cloud API (Meta Business) ── opcional al inicio
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_RECORDATORIO=recordatorio_cita
WHATSAPP_TEMPLATE_RESENA=invitacion_resena

# ── Google Business Profile ── fase 2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
